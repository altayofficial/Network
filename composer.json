{
  "name": "altayofficial/network",
  "description": "Central network library for Altay written in PHP",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.1",
    "ext-sockets": "*",
    "ext-openssl": "*",
    "ext-gmp": "*",
    "pocketmine/binaryutils": "^0.2.6",
    "pocketmine/log": "^0.4.0",
    "react/event-loop": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.0",
    "altayofficial/webrtc": "^1.1.0",
    "react/http": "^1.11"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/altayofficial/webrtc"
    }
  ],
  "autoload": {
    "psr-4": {
      "altay\\network\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "altay\\network\\tests\\": "tests/"
    }
  },
  "suggest": {
    "altayofficial/webrtc": "Required for the NetherNet transport",
    "react/http": "Required for NetherNet endpoint signalling over HTTP"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
